# PharmaSafe Environment Configuration Example
# Copy this file to .env or set environment variables in your system.
# NEVER commit production credentials or passwords to version control.

# Server Configuration
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pharmasafe_db
DB_USERNAME=pharmasafe_user
DB_PASSWORD=your_secure_password_here
DB_URL=jdbc:postgresql://localhost:5432/pharmasafe_db

# Flyway Configuration
FLYWAY_ENABLED=true
