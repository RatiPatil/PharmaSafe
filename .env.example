# PharmaSafe Root Environment Configuration Template
# Copy this file to .env before starting services.
# DO NOT commit .env or real credentials to Git.

# Spring Boot Backend Environment
SERVER_PORT=8080

# PostgreSQL 18 Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pharmasafe_db
DB_USERNAME=pharmasafe_user
DB_PASSWORD=YourSecurePasswordHere
DB_URL=jdbc:postgresql://localhost:5432/pharmasafe_db

# Flyway Migrations
FLYWAY_ENABLED=true

# Frontend Dev Configuration
VITE_API_URL=http://localhost:8080
