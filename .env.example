# PharmaSafe Root Environment Configuration Template
# Copy this file to .env before starting local services.
# DO NOT commit .env or real credentials to Git.

# =============================================================================
# 1. Spring Boot Backend Settings
# =============================================================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# =============================================================================
# 2. Database Connection Settings (Local PostgreSQL or Cloud Supabase)
# =============================================================================
# For Local PostgreSQL:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pharmasafe_db
DB_USERNAME=pharmasafe_user
DB_PASSWORD=YourLocalPasswordHere
DB_SSL_QUERY=

# For Supabase PostgreSQL (Cloud Deployment on Render):
# Use the Supabase Connection Pooler (Session mode, port 5432) for IPv4 compatibility:
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=YourSupabaseDatabasePassword
# DB_SSL_QUERY=?sslmode=require

# Full JDBC URL (optional override - if set, takes precedence over DB_HOST/PORT/NAME)
# DB_URL=jdbc:postgresql://localhost:5432/pharmasafe_db

# Hikari Connection Pool Size (Keep at 3-5 for Render Free 512MB RAM & Supabase pool limits)
HIKARI_MAX_POOL_SIZE=5

# Flyway Migrations (automatically creates tables on startup)
FLYWAY_ENABLED=true

# =============================================================================
# 3. Security, Cookies, and CORS Settings
# =============================================================================
# Local Development:
COOKIE_SAME_SITE=Lax
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloud Production (Render decoupled frontend/backend):
# COOKIE_SAME_SITE=None
# COOKIE_SECURE=true
# CORS_ALLOWED_ORIGINS=https://<your-frontend-subdomain>.onrender.com

# =============================================================================
# 4. Frontend Configuration (Vite)
# =============================================================================
# Empty in local development (uses Vite dev server proxy to http://localhost:8080)
# Set to Render backend URL in cloud production build:
# VITE_API_URL=https://<your-backend-subdomain>.onrender.com
VITE_API_URL=
